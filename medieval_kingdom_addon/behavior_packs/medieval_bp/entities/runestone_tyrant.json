{
  "format_version": "1.21.0",
  "minecraft:entity": {
    "description": {
      "identifier": "md:runestone_tyrant",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false,
      "properties": {
        "md:state": {
          "type": "enum",
          "values": ["idle", "sweep", "stomp", "lure", "burst"],
          "default": "idle",
          "client_sync": true
        },
        "md:awakened": {
          "type": "bool",
          "default": false,
          "client_sync": true
        }
      }
    },
    "component_groups": {
      "tyrant:ready": {
        "minecraft:timer": {
          "looping": false,
          "time": [2.4, 3.8],
          "time_down_event": { "event": "md:tyrant_pick" }
        }
      },
      "tyrant:ready_swift": {
        "minecraft:timer": {
          "looping": false,
          "time": [1.4, 2.4],
          "time_down_event": { "event": "md:tyrant_pick" }
        }
      },
      "tyrant:sweep": {
        "minecraft:area_attack": {
          "damage_range": 4.5,
          "damage_per_tick": 6,
          "cause": "entity_attack",
          "entity_filter": {
            "test": "is_family",
            "subject": "other",
            "value": "player"
          }
        },
        "minecraft:timer": {
          "looping": false,
          "time": 1.6,
          "time_down_event": { "event": "md:tyrant_end" }
        }
      },
      "tyrant:stomp": {
        "minecraft:timer": {
          "looping": false,
          "time": 2.0,
          "time_down_event": { "event": "md:tyrant_end" }
        }
      },
      "tyrant:lure": {
        "minecraft:timer": {
          "looping": false,
          "time": 2.2,
          "time_down_event": { "event": "md:tyrant_end" }
        }
      },
      "tyrant:burst": {
        "minecraft:timer": {
          "looping": false,
          "time": 2.4,
          "time_down_event": { "event": "md:tyrant_end" }
        }
      },
      "tyrant:mortal": {
        "minecraft:damage_sensor": {
          "triggers": [
            {
              "cause": "all",
              "deals_damage": true,
              "on_damage": {
                "filters": {
                  "test": "actor_health",
                  "subject": "self",
                  "operator": "<=",
                  "value": 140
                },
                "event": "md:tyrant_awaken"
              }
            }
          ]
        }
      },
      "tyrant:awakened": {
        "minecraft:movement": { "value": 0.31 },
        "minecraft:attack": { "damage": 18 }
      }
    },
    "components": {
      "minecraft:type_family": {
        "family": ["monster", "boss", "medieval", "tyrant", "dinosaur"]
      },
      "minecraft:collision_box": { "width": 2.4, "height": 3.6 },
      "minecraft:health": { "value": 360, "max": 360 },
      "minecraft:attack": { "damage": 14 },
      "minecraft:movement": { "value": 0.25 },
      "minecraft:knockback_resistance": { "value": 0.95 },
      "minecraft:fire_immune": true,
      "minecraft:persistent": {},
      "minecraft:pushable": { "is_pushable": false, "is_pushable_by_piston": false },
      "minecraft:boss": {
        "should_darken_sky": true,
        "hud_range": 60,
        "name": "Runestone Tyrant"
      },
      "minecraft:nameable": {},
      "minecraft:navigation.walk": {
        "can_path_over_water": true,
        "avoid_water": true,
        "can_break_doors": false
      },
      "minecraft:movement.basic": {},
      "minecraft:jump.static": {},
      "minecraft:can_climb": {},
      "minecraft:physics": {},
      "minecraft:conditional_bandwidth_optimization": {},
      "minecraft:loot": { "table": "loot_tables/entities/runestone_tyrant.json" },
      "minecraft:experience_reward": { "on_death": "70" },
      "minecraft:behavior.float": { "priority": 0 },
      "minecraft:behavior.hurt_by_target": { "priority": 1 },
      "minecraft:behavior.nearest_attackable_target": {
        "priority": 2,
        "must_see": false,
        "reselect_targets": true,
        "scan_interval": 10,
        "within_radius": 48,
        "entity_types": [
          {
            "filters": { "test": "is_family", "subject": "other", "value": "player" },
            "max_dist": 48
          }
        ]
      },
      "minecraft:behavior.melee_attack": {
        "priority": 3,
        "track_target": true,
        "reach_multiplier": 2.2,
        "speed_multiplier": 1.15,
        "cooldown_time": 1.1,
        "melee_fov": 150
      },
      "minecraft:behavior.random_stroll": { "priority": 6, "speed_multiplier": 0.6 },
      "minecraft:behavior.look_at_player": { "priority": 7, "look_distance": 24 },
      "minecraft:behavior.random_look_around": { "priority": 8 }
    },
    "events": {
      "minecraft:entity_spawned": {
        "add": { "component_groups": ["tyrant:mortal", "tyrant:ready"] },
        "set_property": { "md:state": "idle", "md:awakened": false }
      },
      "md:tyrant_pick": {
        "sequence": [
          { "remove": { "component_groups": ["tyrant:ready", "tyrant:ready_swift"] } },
          {
            "randomize": [
              {
                "weight": 3,
                "add": { "component_groups": ["tyrant:sweep"] },
                "set_property": { "md:state": "sweep" }
              },
              {
                "weight": 3,
                "add": { "component_groups": ["tyrant:stomp"] },
                "set_property": { "md:state": "stomp" }
              },
              {
                "weight": 2,
                "add": { "component_groups": ["tyrant:lure"] },
                "set_property": { "md:state": "lure" }
              },
              {
                "weight": 2,
                "add": { "component_groups": ["tyrant:burst"] },
                "set_property": { "md:state": "burst" }
              }
            ]
          }
        ]
      },
      "md:tyrant_end": {
        "sequence": [
          {
            "remove": {
              "component_groups": ["tyrant:sweep", "tyrant:stomp", "tyrant:lure", "tyrant:burst"]
            },
            "set_property": { "md:state": "idle" }
          },
          {
            "filters": { "test": "bool_property", "domain": "md:awakened", "value": false },
            "add": { "component_groups": ["tyrant:ready"] }
          },
          {
            "filters": { "test": "bool_property", "domain": "md:awakened", "value": true },
            "add": { "component_groups": ["tyrant:ready_swift"] }
          }
        ]
      },
      "md:tyrant_awaken": {
        "remove": { "component_groups": ["tyrant:mortal"] },
        "add": { "component_groups": ["tyrant:awakened"] },
        "set_property": { "md:awakened": true }
      }
    }
  }
}
