{
  "format_version": "1.21.0",
  "minecraft:entity": {
    "description": {
      "identifier": "md:siege_golem",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false,
      "properties": {
        "md:state": {
          "type": "enum",
          "values": ["idle", "throw", "slam", "exposed"],
          "default": "idle",
          "client_sync": true
        },
        "md:exposed": {
          "type": "bool",
          "default": false,
          "client_sync": true
        },
        "md:enraged": {
          "type": "bool",
          "default": false,
          "client_sync": true
        }
      }
    },
    "component_groups": {
      "golem:ready": {
        "minecraft:timer": {
          "looping": false,
          "time": [3.0, 5.0],
          "time_down_event": { "event": "md:golem_pick" }
        }
      },
      "golem:throw": {
        "minecraft:behavior.ranged_attack": {
          "priority": 1,
          "attack_interval_min": 0.8,
          "attack_interval_max": 1.0,
          "attack_radius": 36,
          "burst_shots": 2,
          "burst_interval": 0.6
        },
        "minecraft:timer": {
          "looping": false,
          "time": 2.4,
          "time_down_event": { "event": "md:golem_end" }
        }
      },
      "golem:slam": {
        "minecraft:timer": {
          "looping": false,
          "time": 3.0,
          "time_down_event": { "event": "md:golem_expose" }
        }
      },
      "golem:armored": {
        "minecraft:damage_sensor": {
          "triggers": [
            { "cause": "all", "deals_damage": true, "damage_multiplier": 0.35 }
          ]
        }
      },
      "golem:exposed": {
        "minecraft:damage_sensor": {
          "triggers": [
            { "cause": "all", "deals_damage": true, "damage_multiplier": 1.6 }
          ]
        },
        "minecraft:timer": {
          "looping": false,
          "time": 3.0,
          "time_down_event": { "event": "md:golem_rearm" }
        }
      }
    },
    "components": {
      "minecraft:type_family": {
        "family": ["monster", "boss", "medieval", "golem_boss"]
      },
      "minecraft:collision_box": { "width": 2.2, "height": 3.3 },
      "minecraft:health": { "value": 320, "max": 320 },
      "minecraft:attack": { "damage": 12 },
      "minecraft:movement": { "value": 0.22 },
      "minecraft:knockback_resistance": { "value": 1.0 },
      "minecraft:fire_immune": true,
      "minecraft:persistent": {},
      "minecraft:pushable": { "is_pushable": false, "is_pushable_by_piston": false },
      "minecraft:boss": {
        "should_darken_sky": false,
        "hud_range": 55,
        "name": "Siege Golem"
      },
      "minecraft:nameable": {},
      "minecraft:shooter": { "def": "md:boulder" },
      "minecraft:navigation.walk": { "can_path_over_water": true, "avoid_water": false },
      "minecraft:movement.basic": {},
      "minecraft:jump.static": {},
      "minecraft:physics": {},
      "minecraft:conditional_bandwidth_optimization": {},
      "minecraft:loot": { "table": "loot_tables/entities/siege_golem.json" },
      "minecraft:experience_reward": { "on_death": "55" },
      "minecraft:behavior.float": { "priority": 0 },
      "minecraft:behavior.hurt_by_target": { "priority": 1 },
      "minecraft:behavior.nearest_attackable_target": {
        "priority": 2,
        "must_see": false,
        "must_reach": false,
        "reselect_targets": true,
        "scan_interval": 10,
        "within_radius": 48,
        "entity_types": [
          {
            "filters": { "test": "is_family", "subject": "other", "value": "player" },
            "max_dist": 48
          }
        ]
      },
      "minecraft:behavior.melee_attack": {
        "priority": 3,
        "track_target": true,
        "reach_multiplier": 1.8,
        "speed_multiplier": 1.1,
        "cooldown_time": 1.4,
        "melee_fov": 130
      },
      "minecraft:behavior.random_stroll": { "priority": 7, "speed_multiplier": 0.5 },
      "minecraft:behavior.look_at_player": { "priority": 8, "look_distance": 18 },
      "minecraft:behavior.random_look_around": { "priority": 9 }
    },
    "events": {
      "minecraft:entity_spawned": {
        "add": { "component_groups": ["golem:armored", "golem:ready"] },
        "set_property": { "md:exposed": false, "md:enraged": false, "md:state": "idle" }
      },
      "md:golem_pick": {
        "sequence": [
          { "remove": { "component_groups": ["golem:ready"] } },
          {
            "randomize": [
              {
                "weight": 3,
                "add": { "component_groups": ["golem:throw"] },
                "set_property": { "md:state": "throw" }
              },
              {
                "weight": 2,
                "add": { "component_groups": ["golem:slam"] },
                "set_property": { "md:state": "slam" }
              }
            ]
          }
        ]
      },
      "md:golem_end": {
        "remove": { "component_groups": ["golem:throw"] },
        "add": { "component_groups": ["golem:ready"] },
        "set_property": { "md:state": "idle" }
      },
      "md:golem_expose": {
        "remove": { "component_groups": ["golem:slam", "golem:armored"] },
        "add": { "component_groups": ["golem:exposed"] },
        "set_property": { "md:state": "exposed", "md:exposed": true }
      },
      "md:golem_rearm": {
        "remove": { "component_groups": ["golem:exposed"] },
        "add": { "component_groups": ["golem:armored", "golem:ready"] },
        "set_property": { "md:state": "idle", "md:exposed": false }
      }
    }
  }
}
