{
  "format_version": "1.21.0",
  "minecraft:entity": {
    "description": {
      "identifier": "md:soul_wisp",
      "is_spawnable": false,
      "is_summonable": true,
      "is_experimental": false
    },
    "component_groups": {
      "wisp:gone": {
        "minecraft:instant_despawn": {}
