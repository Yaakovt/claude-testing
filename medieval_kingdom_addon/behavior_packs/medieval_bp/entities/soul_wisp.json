        "time": 45,
        "time_down_event": { "event": "md:wisp_expire" }
      },
      "minecraft:behavior.ranged_attack": {
        "priority": 1,
        "attack_interval_min": 1.4,
        "attack_interval_max": 2.2,
        "attack_radius": 14,
