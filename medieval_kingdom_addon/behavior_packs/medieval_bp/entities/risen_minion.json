{
  "format_version": "1.21.0",
  "minecraft:entity": {
    "description": {
      "identifier": "md:risen_minion",
      "is_spawnable": false,
      "is_summonable": true,
      "is_experimental": false
    },
    "component_groups": {
      "risen:gone": { "minecraft:instant_despawn": {} }
    },
    "components": {
      "minecraft:type_family": { "family": ["mob", "medieval", "undead", "risen"] },
      "minecraft:collision_box": { "width": 0.6, "height": 1.9 },
      "minecraft:health": { "value": 20, "max": 20 },
      "minecraft:attack": { "damage": 5 },
      "minecraft:movement": { "value": 0.33 },
      "minecraft:knockback_resistance": { "value": 0.4 },
      "minecraft:navigation.walk": { "can_path_over_water": true, "avoid_water": true },
      "minecraft:movement.basic": {},
      "minecraft:jump.static": {},
      "minecraft:physics": {},
      "minecraft:conditional_bandwidth_optimization": {},
      "minecraft:timer": {
        "looping": false,
        "time": 45,
        "time_down_event": { "event": "md:risen_expire" }
      },
      "minecraft:behavior.float": { "priority": 0 },
      "minecraft:behavior.melee_attack": { "priority": 1, "track_target": true, "speed_multiplier": 1.3, "reach_multiplier": 1.4 },
      "minecraft:behavior.hurt_by_target": { "priority": 2 },
      "minecraft:behavior.nearest_attackable_target": {
        "priority": 3,
        "must_see": false,
        "reselect_targets": true,
        "within_radius": 22,
        "entity_types": [
          { "filters": { "all_of": [
            { "test": "is_family", "subject": "other", "value": "monster" },
            { "test": "is_family", "subject": "other", "operator": "!=", "value": "risen" }
          ] }, "max_dist": 22 }
        ]
      },
      "minecraft:behavior.random_stroll": { "priority": 6, "speed_multiplier": 0.8 },
      "minecraft:behavior.look_at_player": { "priority": 7, "look_distance": 10 }
    },
    "events": {
      "md:risen_expire": { "add": { "component_groups": ["risen:gone"] } }
    }
  }
}
