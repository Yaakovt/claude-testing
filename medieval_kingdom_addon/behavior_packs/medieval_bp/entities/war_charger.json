{
  "format_version": "1.21.0",
  "minecraft:entity": {
    "description": {
      "identifier": "md:war_charger",
      "is_spawnable": false,
      "is_summonable": true,
      "is_experimental": false,
      "properties": {
        "md:freed": {
          "type": "bool",
          "default": false,
          "client_sync": true
        }
      }
    },
    "component_groups": {
      "charger:wild": {
        "minecraft:damage_sensor": {
          "triggers": [{ "cause": "all", "deals_damage": false }]
        },
        "minecraft:behavior.nearest_attackable_target": {
          "priority": 2,
          "must_see": false,
          "reselect_targets": true,
          "within_radius": 40,
          "entity_types": [
            { "filters": { "test": "is_family", "subject": "other", "value": "player" }, "max_dist": 40 }
          ]
        },
        "minecraft:behavior.move_towards_target": {
          "priority": 3,
          "speed_multiplier": 1.6,
          "within_radius": 32
        }
      },
      "charger:freed": {
        "minecraft:is_tamed": {},
        "minecraft:rideable": {
          "seat_count": 1,
          "family_types": ["player"],
          "interact_text": "action.interact.ride.horse",
          "seats": [{ "position": [0.0, 1.55, -0.2] }]
        },
        "minecraft:input_ground_controlled": {},
        "minecraft:behavior.player_ride_tamed": {},
        "minecraft:behavior.panic": { "priority": 1, "speed_multiplier": 1.2 }
      }
    },
    "components": {
      "minecraft:type_family": { "family": ["mob", "medieval", "war_charger"] },
      "minecraft:collision_box": { "width": 1.4, "height": 1.7 },
      "minecraft:health": { "value": 45, "max": 45 },
      "minecraft:movement": { "value": 0.36 },
      "minecraft:knockback_resistance": { "value": 0.6 },
      "minecraft:fire_immune": true,
      "minecraft:persistent": {},
      "minecraft:conditional_bandwidth_optimization": {},
      "minecraft:navigation.walk": { "can_path_over_water": true, "avoid_water": true },
      "minecraft:movement.basic": {},
      "minecraft:jump.static": {},
      "minecraft:physics": {},
      "minecraft:horse.jump_strength": { "value": 0.7 },
      "minecraft:rideable": {
        "seat_count": 1,
        "family_types": ["rider"],
        "seats": [{ "position": [0.0, 1.55, -0.2] }]
      },
      "minecraft:behavior.float": { "priority": 0 },
      "minecraft:behavior.look_at_player": { "priority": 8, "look_distance": 10 },
      "minecraft:behavior.random_look_around": { "priority": 9 }
    },
    "events": {
      "minecraft:entity_spawned": {
        "add": { "component_groups": ["charger:wild"] },
        "set_property": { "md:freed": false }
      },
      "md:charger_free": {
        "remove": { "component_groups": ["charger:wild"] },
        "add": { "component_groups": ["charger:freed"] },
        "set_property": { "md:freed": true }
      }
    }
  }
}
