{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.humanoid_medieval": {
      "geometry": "Geometry.default",
      "materials": [{ "*": "Material.default" }],
      "textures": ["Texture.default"]
    },
    "controller.render.animated_armor": {
      "arrays": {
        "textures": {
          "Array.skins": ["Texture.default", "Texture.broken"]
        }
      },
      "geometry": "Geometry.default",
      "part_visibility": [
        { "*": true },
        { "plume": "query.property('md:stage') < 1" },
        { "leftPauldron": "query.property('md:stage') < 1" },
        { "faulds": "query.property('md:stage') < 2" },
        { "rightPauldron": "query.property('md:stage') < 2" },
        { "chestPlate": "query.property('md:stage') < 3" },
        { "visor": "query.property('md:stage') < 3" },
        { "leftGauntlet": "query.property('md:stage') < 3" },
        { "rightGauntlet": "query.property('md:stage') < 3" }
      ],
      "materials": [{ "*": "Material.default" }],
      "textures": ["Array.skins[(query.property('md:stage') >= 2) ? 1 : 0]"]
    },
    "controller.render.fire_dragon": {
      "arrays": {
        "textures": {
          "Array.phases": ["Texture.default", "Texture.ice", "Texture.poison"]
        }
      },
      "geometry": "Geometry.default",
      "materials": [{ "*": "Material.default" }],
      "textures": ["Array.phases[math.clamp(query.property('md:phase'), 0, 2)]"]
    },
    "controller.render.dragon_fireball": {
      "geometry": "Geometry.default",
      "materials": [{ "*": "Material.default" }],
      "textures": ["Texture.default"]
    },
    "controller.render.fire_sphere": {
      "geometry": "Geometry.default",
      "materials": [{ "*": "Material.sphere" }],
      "textures": ["Texture.default"]
    },
    "controller.render.lich_king": {
      "arrays": {
        "textures": {
          "Array.skins": ["Texture.default", "Texture.wraith"]
        }
      },
      "geometry": "Geometry.default",
      "part_visibility": [
        { "*": true },
        { "shards": "query.property('md:stage') < 1" },
        { "crown": "query.property('md:stage') < 2" }
      ],
      "materials": [{ "*": "Material.default" }],
      "textures": ["Array.skins[(query.property('md:stage') >= 2) ? 1 : 0]"]
    },
    "controller.render.siege_golem": {
      "arrays": {
        "textures": {
          "Array.skins": ["Texture.default", "Texture.cracked"]
        }
      },
      "geometry": "Geometry.default",
      "part_visibility": [
        { "*": true },
        { "rightPauldron": "query.property('md:stage') < 1" },
        { "leftPauldron": "query.property('md:stage') < 2" },
        { "chestPlate": "query.property('md:stage') < 3" }
      ],
      "materials": [{ "*": "Material.default" }],
      "textures": ["Array.skins[(query.property('md:stage') >= 2) ? 1 : 0]"]
    },
    "controller.render.black_knight": {
      "arrays": {
        "textures": {
          "Array.skins": ["Texture.default", "Texture.berserk"]
        }
      },
      "geometry": "Geometry.default",
      "part_visibility": [
        { "*": true },
        { "shield": "query.property('md:stage') < 1" },
        { "plume": "query.property('md:stage') < 2" },
        { "cape": "query.property('md:stage') < 3" }
      ],
      "materials": [{ "*": "Material.default" }],
      "textures": ["Array.skins[(query.property('md:stage') >= 3) ? 1 : 0]"]
    },
    "controller.render.war_horse": {
      "arrays": {
        "textures": {
          "Array.skins": ["Texture.default", "Texture.armored"]
        }
      },
      "geometry": "Geometry.default",
      "materials": [{ "*": "Material.default" }],
      "textures": ["Array.skins[query.property('md:armored') ? 1 : 0]"]
    }
  }
}
