{
  "format_version": "1.8.0",
  "animations": {
    "animation.animated_armor.spawn": {
      "loop": false,
      "animation_length": 1.5,
      "bones": {
        "root": { "position": { "0.0": [0, -22, 0], "1.0": [0, 0, 0], "1.5": [0, 0, 0] } },
        "head": { "rotation": { "0.0": [40, 0, 0], "1.2": [-8, 0, 0], "1.5": [0, 0, 0] } },
        "rightArm": { "rotation": { "0.0": [0, 0, 60], "1.2": [0, 0, -6], "1.5": [0, 0, 2] } },
        "leftArm": { "rotation": { "0.0": [0, 0, -60], "1.2": [0, 0, 6], "1.5": [0, 0, -2] } }
      }
    },
    "animation.animated_armor.idle": {
      "loop": true,
      "bones": {
        "body": { "rotation": ["math.sin(query.life_time * 45) * 1.5", 0, 0] },
        "head": { "rotation": ["math.sin(query.life_time * 45) * 2", "math.sin(query.life_time * 20) * 5", 0] },
        "rightArm": { "rotation": [0, 0, "math.cos(query.life_time * 45) * 1.5 + 3"] },
        "leftArm": { "rotation": [0, 0, "-math.cos(query.life_time * 45) * 1.5 - 3"] }
      }
    },
    "animation.animated_armor.walk": {
      "loop": true,
      "bones": {
        "rightLeg": { "rotation": ["math.cos(query.modified_distance_moved * 32) * 32", 0, 0] },
        "leftLeg": { "rotation": ["-math.cos(query.modified_distance_moved * 32) * 32", 0, 0] },
        "rightArm": { "rotation": ["-math.cos(query.modified_distance_moved * 32) * 16", 0, 4] },
        "leftArm": { "rotation": ["math.cos(query.modified_distance_moved * 32) * 16", 0, -4] },
        "body": { "rotation": [0, "math.cos(query.modified_distance_moved * 32) * 4", 0] }
      }
    },
    "animation.animated_armor.attack_swing": {
      "loop": false,
      "animation_length": 0.7,
      "bones": {
        "rightArm": {
          "rotation": {
            "0.0": [0, 0, 3],
            "0.18": [-150, -10, 3],
            "0.4": [40, 0, 3],
            "0.7": [0, 0, 3]
          }
        },
        "body": {
          "rotation": { "0.0": [0, 0, 0], "0.18": [-8, -18, 0], "0.4": [12, 14, 0], "0.7": [0, 0, 0] }
        }
      },
      "sound_effects": { "0.18": { "effect": "hammer_swing" } }
    },
    "animation.animated_armor.attack_smash": {
      "loop": false,
      "animation_length": 1.3,
      "bones": {
        "rightArm": {
          "rotation": {
            "0.0": [0, 0, 3],
            "0.5": [-170, 0, 3],
            "0.75": [50, 0, 3],
            "1.3": [0, 0, 3]
          }
        },
        "leftArm": {
          "rotation": { "0.0": [0, 0, -3], "0.5": [-120, 0, -3], "0.75": [30, 0, -3], "1.3": [0, 0, -3] }
        },
        "body": {
          "rotation": { "0.0": [0, 0, 0], "0.5": [-22, 0, 0], "0.75": [35, 0, 0], "1.0": [10, 0, 0], "1.3": [0, 0, 0] }
        },
        "root": {
          "position": { "0.0": [0, 0, 0], "0.5": [0, 6, 0], "0.72": [0, 0, 0], "0.78": [0, -1, 0], "1.3": [0, 0, 0] }
        }
      },
      "particle_effects": { "0.75": { "effect": "shockwave" } },
      "sound_effects": { "0.75": { "effect": "hammer_smash" } }
    },
    "animation.animated_armor.attack_spin": {
      "loop": false,
      "animation_length": 1.5,
      "bones": {
        "body": {
          "rotation": { "0.0": [0, 0, 0], "0.2": [0, 0, 0], "1.3": [0, 720, 0], "1.5": [0, 720, 0] }
        },
        "rightArm": {
          "rotation": { "0.0": [0, 0, 3], "0.2": [-8, 0, -92], "1.3": [-8, 0, -92], "1.5": [0, 0, 3] }
        },
        "leftArm": {
          "rotation": { "0.0": [0, 0, -3], "0.2": [-8, 0, 92], "1.3": [-8, 0, 92], "1.5": [0, 0, -3] }
        },
        "head": { "rotation": { "0.0": [0, 0, 0], "0.2": [10, 0, 0], "1.3": [10, 0, 0], "1.5": [0, 0, 0] } }
      },
      "particle_effects": {
        "0.3": { "effect": "spin_sparks" },
        "0.7": { "effect": "spin_sparks" },
        "1.1": { "effect": "spin_sparks" }
      },
      "sound_effects": { "0.2": { "effect": "hammer_spin" } }
    },
    "animation.animated_armor.breaking": {
      "loop": true,
      "bones": {
        "plume": { "scale": "(query.property('md:stage') < 1) ? 1 : 0" },
        "leftPauldron": { "scale": "(query.property('md:stage') < 1) ? 1 : 0" },
        "faulds": { "scale": "(query.property('md:stage') < 2) ? 1 : 0" },
        "rightPauldron": { "scale": "(query.property('md:stage') < 2) ? 1 : 0" },
        "chestPlate": { "scale": "(query.property('md:stage') < 3) ? 1 : 0" },
        "visor": { "scale": "(query.property('md:stage') < 3) ? 1 : 0" },
        "leftGauntlet": { "scale": "(query.property('md:stage') < 3) ? 1 : 0" },
        "rightGauntlet": { "scale": "(query.property('md:stage') < 3) ? 1 : 0" },
        "head": { "rotation": ["(query.property('md:stage') >= 3) ? math.sin(query.life_time * 120) * 4 : 0", 0, 0] }
      }
    }
  }
}
